 CompileFlags:
  Add: 
    - -std=c++23
    - -I/usr/include/c++/15
    - -I/usr/include/x86_64-linux-gnu/c++/15
    - -I/home/pouya/dev/cp/lib/
    - -Wall
    - -Wno-sign-compare
    - -Wno-unused-variable
    - -Wno-unused-parameter
    - -Wno-attributes
    - -DLOCAL

Diagnostics:
  Suppress: 
    - pp_file_not_found

